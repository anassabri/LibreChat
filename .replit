modules = ["web", "go-1.21", "nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LibreChat"

[[workflows.workflow]]
name = "LibreChat"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
