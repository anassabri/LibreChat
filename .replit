modules = ["web", "go-1.21", "nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "LibreChat"

[[workflows.workflow]]
name = "LibreChat"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.development]
ALLOW_REGISTRATION = "true"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "scripts/replit.sh"]
build = ["npm", "run", "frontend"]
